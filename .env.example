# Copy to `.env` and fill in. `.env` is gitignored.
#
# electron-vite only exposes variables prefixed `MAIN_VITE_` to the main
# process, `RENDERER_VITE_` to the renderer, etc. `GITHUB_` is allowed as well
# (see envPrefix in electron.vite.config.ts), so either spelling below works —
# a bare GITHUB_CLIENT_ID is fine and needs no rename.

# ---------------------------------------------------------------------------
# GitHub OAuth Device Flow (blueprint §9) — REQUIRED
# ---------------------------------------------------------------------------
# From github.com → Settings → Developer settings → OAuth Apps → your app.
#
# This is not a secret. The device flow grant has no client secret, which is
# exactly why the blueprint chose it, so inlining the ID at build time is
# correct rather than a leak.
#
# The OAuth App must have "Enable Device Flow" checked in its settings —
# without it GitHub rejects the grant with `unsupported_grant_type`.
# Must be an OAuth App client ID (starts "Ov"), not a GitHub App ("Iv") —
# GitHub App user tokens expire after 8 hours and refreshing them needs a
# client secret a desktop app has nowhere safe to hold. The app warns if an
# "Iv" id is configured.
MAIN_VITE_GITHUB_CLIENT_ID=

# Optional. Defaults to "repo read:user" when unset.
#   repo       — Phase 9 needs it to push branches and open PRs
#   read:user  — used only to show which account is connected
MAIN_VITE_GITHUB_SCOPES=repo read:user

# ---------------------------------------------------------------------------
# Dev-only escape hatches — OPTIONAL, leave blank in normal use
# ---------------------------------------------------------------------------
# Onboarding stores these in the OS keychain via Electron `safeStorage`. These
# exist only so a developer can skip onboarding on a throwaway profile.
# A key stored in the keychain always takes precedence over these.
MAIN_VITE_ANTHROPIC_API_KEY=
MAIN_VITE_OPENAI_API_KEY=
